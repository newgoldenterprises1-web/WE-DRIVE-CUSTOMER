rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isDriver() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver';
    }

    function isOwner() {
      return signedIn() && resource.data.customerId == request.auth.uid;
    }

    // ----------------------------------------------------------
    // USERS
    // ----------------------------------------------------------
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId || isAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'customer';

      // Customer may update profile fields, but cannot promote
      // themselves or change role/driver/admin flags.
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.role == 'customer'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'uid', 'name', 'email', 'photoUrl', 'phone', 'age', 'gender',
            'profileCompleted', 'updatedAt'
          ]));

      allow delete: if isAdmin();
    }

    // ----------------------------------------------------------
    // BOOKINGS
    // ----------------------------------------------------------
    match /bookings/{bookingId} {
      // Customer creates only their own booking and it must begin
      // in the controlled searching state.
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'searching'
        && request.resource.data.driverId == null;

      // Customer can read only their own booking. Admins and the
      // assigned driver can also read it.
      allow read: if isAdmin()
        || isOwner()
        || (isDriver() && resource.data.driverId == request.auth.uid);

      // Customer can only cancel their own active booking. They
      // cannot change driver, fare, status, payment or timestamps.
      allow update: if isAdmin()
        || (isOwner()
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'cancelled')
        || (isDriver()
          && resource.data.driverId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'driverName', 'driverPhone', 'vehicle'
          ])
          && request.resource.data.status in ['accepted', 'arriving', 'arrived', 'in_progress', 'completed']);

      allow delete: if isAdmin();
    }

    // ----------------------------------------------------------
    // DENY EVERYTHING ELSE
    // ----------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
