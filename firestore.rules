rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isDriver() { return signedIn() && request.auth.token.role == 'driver'; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }

    match /partners/{partnerId} {
      allow read: if signedIn();
      allow create, update: if isDriver() && request.auth.uid == partnerId;
      allow delete: if false;
      match /earnings/{earningId} {
        allow read: if isDriver() && request.auth.uid == partnerId;
        allow write: if false;
      }
      match /withdrawals/{withdrawalId} {
        allow read: if isDriver() && request.auth.uid == partnerId;
        allow write: if false;
      }
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /payoutRequests/{payoutId} {
      allow read: if isDriver() && resource.data.partnerId == request.auth.uid;
      allow write: if false;
    }

    match /bookings/{bookingId} {
      // Customer creates a request. Admin/driver roles are granted by trusted auth/backend code.
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.bookingId == bookingId
        && request.resource.data.status in ['SEARCHING', 'REQUESTED', 'searching', 'requested']
        && request.resource.data.driverId == null;

      // Customer sees own booking, drivers see available/assigned work, and admins see all bookings.
      allow get: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        isAdmin() ||
        (isDriver() && (
          resource.data.partnerId == request.auth.uid ||
          resource.data.driverId == request.auth.uid ||
          resource.data.status in ['SEARCHING', 'REQUESTED', 'searching', 'requested']
        ))
      );

      allow list: if signedIn() && (
        resource.data.customerId == request.auth.uid || isAdmin() || isDriver()
      );

      // Customer can only cancel their own booking.
      // Driver can only update operational fields after assignment.
      // Admin can assign/reassign and manage the operational booking lifecycle.
      allow update: if signedIn() && (
        (
          resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'bookingStatus', 'updatedAt',
            'cancelledAt', 'cancelledBy', 'cancellationReason'
          ])
          && request.resource.data.status == 'cancelled'
        ) || (
          isDriver()
          && resource.data.driverId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'bookingStatus', 'updatedAt',
            'driverName', 'driverPhone', 'vehicle'
          ])
          && request.resource.data.status in [
            'accepted', 'arriving', 'arrived', 'in_progress', 'completed'
          ]
        ) || (
          isAdmin()
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.bookingId == resource.data.bookingId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'bookingStatus', 'updatedAt',
            'driverId', 'partnerId', 'driverName', 'driverPhone', 'vehicle'
          ])
          && request.resource.data.status in [
            'SEARCHING', 'REQUESTED', 'searching', 'requested',
            'assigned', 'accepted', 'arriving', 'arrived',
            'in_progress', 'completed', 'cancelled'
          ]
        )
      );

      allow delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow create: if isDriver() && request.resource.data.userId == request.auth.uid;
      allow read: if isDriver() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /profiles/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
